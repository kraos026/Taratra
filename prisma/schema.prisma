generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

enum OrganizationRole {
  owner
  admin
  consultant
  viewer

  @@map("organization_role")
  @@schema("public")
}

enum CompanySize {
  micro
  small
  medium
  large
  enterprise

  @@map("company_size")
  @@schema("public")
}

enum CompanyStatus {
  prospect
  contacted
  audit_scheduled
  audit_in_progress
  client
  archived

  @@map("company_status")
  @@schema("public")
}

enum QuestionnaireVersionStatus {
  draft
  published
  archived

  @@map("questionnaire_version_status")
  @@schema("public")
}

enum QuestionType {
  short_text
  long_text
  number
  boolean
  single_choice
  multiple_choice
  percentage
  currency
  date

  @@map("question_type")
  @@schema("public")
}

