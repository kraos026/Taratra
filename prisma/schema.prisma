generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

enum OrganizationRole {
  owner
  admin
  consultant
  viewer

  @@map("organization_role")
  @@schema("public")
}

enum CompanySize {
  micro
  small
  medium
  large
  enterprise

  @@map("company_size")
  @@schema("public")
}

enum CompanyStatus {
  prospect
  contacted
  audit_scheduled
  audit_in_progress
  client
  archived

  @@map("company_status")
  @@schema("public")
}

enum QuestionnaireVersionStatus {
  draft
  published
  archived

  @@map("questionnaire_version_status")
  @@schema("public")
}

enum QuestionType {
  short_text
  long_text
  number
  boolean
  single_choice
  multiple_choice
  percentage
  currency
  date

  @@map("question_type")
  @@schema("public")
}

enum AuditStatus {
  draft
  in_progress
  completed
  validated
  archived

  @@map("audit_status")
  @@schema("public")
}

enum RuleSeverity {
  info
  low
  medium
  high
  critical

  @@map("rule_severity")
  @@schema("public")
}

enum ImplementationDifficulty {
  very_low
  low
  medium
  high
  very_high

  @@map("implementation_difficulty")
  @@schema("public")
}

enum DiscoveryStatus {
  draft
  in_progress
  completed
  validated
  archived

  @@map("discovery_status")
  @@schema("public")
}

enum DiscoveryStep {
  company
  business
  organization
  software
  processes
  review

  @@map("discovery_step")
  @@schema("public")
}

enum OfferingType {
  product
  service

  @@map("offering_type")
  @@schema("public")
}

enum InterviewStatus {
  draft
  in_progress
  completed
  validated
  archived

  @@map("interview_status")
  @@schema("public")
}

enum InterviewAnswerType {
  short_text
  long_text
  number
  boolean
  single_choice
  multiple_choice

  @@map("interview_answer_type")
  @@schema("public")
}

enum InterviewSkipReason {
  irrelevant
  unknown
  deferred

  @@map("interview_skip_reason")
  @@schema("public")
}

enum EvidenceConfidence {
  validated
  confirmed
  uncertain
  missing

  @@map("evidence_confidence")
  @@schema("public")
}

enum KnowledgeSnapshotStatus {
  building
  ready
  failed

  @@map("knowledge_snapshot_status")
  @@schema("public")
}

enum KnowledgeSourceType {
  discovery
  interview
  connector
  manual_validation
  ai_inference

  @@map("knowledge_source_type")
  @@schema("public")
}

enum ProcessPatternStatus {
  draft
  published
  archived

  @@map("process_pattern_status")
  @@schema("public")
}

enum ProcessMapStatus {
  draft
  validated
  published
  archived

  @@map("process_map_status")
  @@schema("public")
}

enum ProcessValidationSeverity {
  error
  warning
  information

  @@map("process_validation_severity")
  @@schema("public")
}

enum ProcessNodeType {
  process
  step
  decision
  document
  actor
  system
  event
  input
  output

  @@map("process_node_type")
  @@schema("public")
}

enum ProcessEdgeType {
  produces
  consumes
  uses
  sends
  approves
  transfers
  depends_on
  triggers

  @@map("process_edge_type")
  @@schema("public")
}

model Organization {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(6)
  members                OrganizationMember[]
  companies              Company[]
  audits                 Audit[]
  questionnaireTemplates QuestionnaireTemplate[]
  auditAnswers           AuditAnswer[]
  ruleCategories         RuleCategory[]
  rules                  Rule[]
  auditRuleMatches       AuditRuleMatch[]
  auditScores            AuditScore[]
  recommendations        Recommendation[]
  roiProfiles            RoiProfile[]
  auditRecommendations   AuditRecommendation[]

  @@map("organizations")
  @@schema("public")
}

model OrganizationMember {
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(consultant)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id])

  @@id([organizationId, userId])
  @@index([userId], map: "organization_members_user_idx")
  @@index([organizationId, role], map: "organization_members_role_idx")
  @@map("organization_members")
  @@schema("public")
}

model Company {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  name               String
  sectorId           String?         @map("sector_id")
  employeeCount      Int?            @map("employee_count")
  companySize        CompanySize?    @map("company_size")
  primaryContactName String?         @map("primary_contact_name")
  primaryContactRole String?         @map("primary_contact_role")
  phone              String?
  email              String?
  website            String?
  address            String?
  city               String?
  country            String?
  description        String?
  internalNotes      String?         @map("internal_notes")
  status             CompanyStatus   @default(prospect)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(6)
  organization       Organization    @relation(fields: [organizationId], references: [id])
  audits             Audit[]
  discoveryProfile   CompanyProfile?

  @@unique([organizationId, id], map: "companies_organization_id_id_key")
  @@index([organizationId], map: "companies_organization_idx")
  @@index([organizationId, status], map: "companies_status_idx")
  @@index([organizationId, companySize], map: "companies_size_idx")
  @@index([organizationId, sectorId], map: "companies_sector_idx")
  @@index([organizationId, createdAt(sort: Desc)], map: "companies_created_at_idx")
  @@map("companies")
  @@schema("public")
}

model Audit {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                @map("organization_id") @db.Uuid
  companyId              String                @map("company_id") @db.Uuid
  status                 AuditStatus           @default(draft)
  questionnaireVersionId String?               @map("questionnaire_version_id") @db.Uuid
  ruleSetVersion         String?               @map("rule_set_version")
  startedAt              DateTime?             @map("started_at") @db.Timestamptz(6)
  completedAt            DateTime?             @map("completed_at") @db.Timestamptz(6)
  progressPercentage     Int                   @default(0) @map("progress_percentage")
  currentSectionId       String?               @map("current_section_id") @db.Uuid
  validatedAt            DateTime?             @map("validated_at") @db.Timestamptz(6)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?             @map("deleted_at") @db.Timestamptz(6)
  organization           Organization          @relation(fields: [organizationId], references: [id])
  company                Company               @relation(fields: [organizationId, companyId], references: [organizationId, id])
  questionnaireVersion   QuestionnaireVersion? @relation(fields: [questionnaireVersionId], references: [id])
  currentSection         QuestionnaireSection? @relation(fields: [currentSectionId], references: [id])
  answers                AuditAnswer[]
  ruleMatches            AuditRuleMatch[]
  scores                 AuditScore[]
  recommendations        AuditRecommendation[]

  @@unique([id, organizationId])
  @@unique([id, questionnaireVersionId])
  @@index([organizationId, companyId], map: "audits_organization_company_idx")
  @@index([questionnaireVersionId], map: "audits_questionnaire_version_idx")
  @@index([organizationId, status], map: "audits_status_idx")
  @@map("audits")
  @@schema("public")
}

model QuestionnaireTemplate {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?                @map("organization_id") @db.Uuid
  name           String
  description    String?
  category       String
  isSystem       Boolean                @default(false) @map("is_system")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?              @map("deleted_at") @db.Timestamptz(6)
  organization   Organization?          @relation(fields: [organizationId], references: [id])
  versions       QuestionnaireVersion[]

  @@index([organizationId], map: "questionnaire_templates_organization_idx")
  @@map("questionnaire_templates")
  @@schema("public")
}

model QuestionnaireVersion {
  id                      String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionnaireTemplateId String                     @map("questionnaire_template_id") @db.Uuid
  versionNumber           Int                        @map("version_number")
  status                  QuestionnaireVersionStatus @default(draft)
  publishedAt             DateTime?                  @map("published_at") @db.Timestamptz(6)
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)
  template                QuestionnaireTemplate      @relation(fields: [questionnaireTemplateId], references: [id])
  sections                QuestionnaireSection[]
  audits                  Audit[]

  @@unique([questionnaireTemplateId, versionNumber])
  @@unique([id, questionnaireTemplateId])
  @@index([questionnaireTemplateId, versionNumber(sort: Desc)], map: "questionnaire_versions_template_idx")
  @@map("questionnaire_versions")
  @@schema("public")
}

model QuestionnaireSection {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionnaireVersionId String                  @map("questionnaire_version_id") @db.Uuid
  title                  String
  description            String?
  position               Int
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  version                QuestionnaireVersion    @relation(fields: [questionnaireVersionId], references: [id], onDelete: Cascade)
  questions              QuestionnaireQuestion[]
  currentAudits          Audit[]

  @@unique([questionnaireVersionId, position])
  @@unique([id, questionnaireVersionId])
  @@map("questionnaire_sections")
  @@schema("public")
}

model QuestionnaireQuestion {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionnaireSectionId String               @map("questionnaire_section_id") @db.Uuid
  code                   String
  label                  String
  description            String?
  questionType           QuestionType         @map("question_type")
  required               Boolean              @default(false)
  position               Int
  optionsJson            Json?                @map("options_json")
  validationJson         Json                 @default("{}") @map("validation_json")
  metadataJson           Json                 @default("{}") @map("metadata_json")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  section                QuestionnaireSection @relation(fields: [questionnaireSectionId], references: [id], onDelete: Cascade)
  answers                AuditAnswer[]

  @@unique([questionnaireSectionId, position])
  @@index([questionnaireSectionId, position], map: "questionnaire_questions_section_idx")
  @@map("questionnaire_questions")
  @@schema("public")
}

model AuditAnswer {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  auditId        String                @map("audit_id") @db.Uuid
  questionId     String                @map("question_id") @db.Uuid
  valueJson      Json                  @map("value_json")
  answeredBy     String                @map("answered_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization   Organization          @relation(fields: [organizationId], references: [id])
  audit          Audit                 @relation(fields: [auditId, organizationId], references: [id, organizationId], onDelete: Cascade)
  question       QuestionnaireQuestion @relation(fields: [questionId], references: [id])

  @@unique([auditId, questionId])
  @@index([auditId], map: "audit_answers_audit_idx")
  @@index([organizationId], map: "audit_answers_organization_idx")
  @@map("audit_answers")
  @@schema("public")
}

model RuleCategory {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String?          @map("organization_id") @db.Uuid
  code            String
  name            String
  description     String?
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules           Rule[]
  auditScores     AuditScore[]
  recommendations Recommendation[]

  @@map("rule_categories")
  @@schema("public")
}

model Rule {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String?              @map("organization_id") @db.Uuid
  categoryId      String               @map("category_id") @db.Uuid
  code            String
  name            String
  description     String?
  priority        Int                  @default(100)
  severity        RuleSeverity         @default(medium)
  weight          Decimal              @default(1) @db.Decimal(12, 4)
  conditionJson   Json                 @map("condition_json")
  resultJson      Json                 @default("{}") @map("result_json")
  active          Boolean              @default(true)
  version         Int                  @default(1)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization    Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        RuleCategory         @relation(fields: [categoryId], references: [id])
  results         RuleResult[]
  auditMatches    AuditRuleMatch[]
  recommendations RuleRecommendation[]

  @@index([categoryId, active, priority], map: "rules_category_active_idx")
  @@map("rules")
  @@schema("public")
}

model Recommendation {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String?                  @map("organization_id") @db.Uuid
  code                     String
  version                  Int                      @default(1)
  title                    String
  summary                  String
  description              String
  implementationDifficulty ImplementationDifficulty @map("implementation_difficulty")
  categoryId               String                   @map("category_id") @db.Uuid
  active                   Boolean                  @default(true)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization             Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category                 RuleCategory             @relation(fields: [categoryId], references: [id])
  impact                   RecommendationImpact?
  rules                    RuleRecommendation[]
  audits                   AuditRecommendation[]

  @@map("recommendations")
  @@schema("public")
}

model RecommendationImpact {
  recommendationId       String         @id @map("recommendation_id") @db.Uuid
  estimatedHoursPerMonth Decimal        @map("estimated_hours_per_month") @db.Decimal(12, 2)
  estimatedCost          Decimal        @map("estimated_cost") @db.Decimal(14, 2)
  estimatedSavings       Decimal        @default(0) @map("estimated_savings") @db.Decimal(14, 2)
  metadataJson           Json           @default("{}") @map("metadata_json")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  recommendation         Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@map("recommendation_impacts")
  @@schema("public")
}

model RuleRecommendation {
  ruleId           String         @map("rule_id") @db.Uuid
  recommendationId String         @map("recommendation_id") @db.Uuid
  active           Boolean        @default(true)
  priority         Int            @default(100)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  rule             Rule           @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@id([ruleId, recommendationId])
  @@map("rule_recommendations")
  @@schema("public")
}

model RoiProfile {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String?       @map("organization_id") @db.Uuid
  code            String
  name            String
  currency        String        @db.Char(3)
  hourlyCost      Decimal       @map("hourly_cost") @db.Decimal(14, 2)
  workingDaysYear Decimal       @map("working_days_year") @db.Decimal(6, 2)
  workingHoursDay Decimal       @map("working_hours_day") @db.Decimal(4, 2)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("roi_profiles")
  @@schema("public")
}

model AuditRecommendation {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String         @map("organization_id") @db.Uuid
  auditId              String         @map("audit_id") @db.Uuid
  recommendationId     String         @map("recommendation_id") @db.Uuid
  evaluationId         String         @map("evaluation_id") @db.Uuid
  priority             String
  estimatedHoursYear   Decimal        @map("estimated_hours_year") @db.Decimal(14, 2)
  estimatedSavingsYear Decimal        @map("estimated_savings_year") @db.Decimal(14, 2)
  roiPercentage        Decimal        @map("roi_percentage") @db.Decimal(14, 2)
  implementationCost   Decimal        @map("implementation_cost") @db.Decimal(14, 2)
  paybackMonths        Decimal?       @map("payback_months") @db.Decimal(14, 2)
  quickWin             Boolean        @map("quick_win")
  strategic            Boolean
  metadataJson         Json           @default("{}") @map("metadata_json")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit                Audit          @relation(fields: [auditId, organizationId], references: [id, organizationId], onDelete: Cascade)
  recommendation       Recommendation @relation(fields: [recommendationId], references: [id])

  @@unique([auditId, recommendationId])
  @@map("audit_recommendations")
  @@schema("public")
}

model CompanyProfile {
  companyId       String   @id @map("company_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  industry        String?  @db.Text
  countryCode     String?  @map("country_code") @db.Char(2)
  revenueAmount   Decimal? @map("revenue_amount") @db.Decimal(18, 2)
  revenueCurrency String?  @map("revenue_currency") @db.Char(3)
  revenueYear     Int?     @map("revenue_year")
  businessModel   String?  @map("business_model")
  growthStage     String?  @map("growth_stage")
  employeeCount   Int?     @map("employee_count")
  metadataJson    Json     @default("{}") @map("metadata_json")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  company         Company  @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, companyId])
  @@map("company_profiles")
  @@schema("public")
}

model CompanyOffering {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  type           OfferingType
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("company_offerings")
  @@schema("public")
}

model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String
  description    String?
  headcount      Int?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("departments")
  @@schema("public")
}

model CompanyRole {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  departmentId         String?  @map("department_id") @db.Uuid
  title                String
  headcount            Int      @default(1)
  responsibilitiesJson Json     @default("[]") @map("responsibilities_json")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("company_roles")
  @@schema("public")
}

model SoftwareCategory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  code           String
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("software_categories")
  @@schema("public")
}

model Software {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  name           String
  vendor         String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("software")
  @@schema("public")
}

model CompanySoftware {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  softwareId     String?  @map("software_id") @db.Uuid
  customName     String?  @map("custom_name")
  purpose        String?
  criticality    Int?
  usersCount     Int?     @map("users_count")
  metadataJson   Json     @default("{}") @map("metadata_json")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("company_software")
  @@schema("public")
}

model ProcessCategory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  code           String
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("process_categories")
  @@schema("public")
}

model BusinessProcess {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
