NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
DATABASE_URL=postgresql://user:password@host:port/database
DIRECT_URL=postgresql://user:password@host:port/database
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
VERCEL_AUTOMATION_BYPASS_SECRET=your_vercel_bypass_secret
AUTOMATEX_E2E_BASE_URL=http://localhost:3000
AUTOMATEX_CERTIFICATION_DB=false
AUTOMATEX_CERTIFICATION_TARGET=local
OPENAI_API_KEY=
# Atelier IA: opt-in for a local or Preview lab only. Real execution remains disabled.
NEXT_PUBLIC_OPTIVOS_ATELIER_IA_LAB=0
# Hermes health only: bind exactly one company. Server-only; never use NEXT_PUBLIC for these.
# API_URL is an HTTPS origin or local SSH tunnel (http://127.0.0.1:8642).
OPTIVOS_HERMES_COMPANY_ID=
OPTIVOS_HERMES_API_URL=
OPTIVOS_HERMES_API_KEY=
